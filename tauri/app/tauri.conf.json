{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlumsMS Launcher",
  "mainBinaryName": "SlumsMS Launcher",
  "identifier": "com.slumsms.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SlumsMS Launcher",
        "width": 1060,
        "height": 860,
        "minWidth": 860,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#16203a",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRDhGMUY1NjdCN0ZFNzkKUldSNS9yZG45ZkhZWXJGUWlhTDZTZ0xnaGF1aTRtdXV5N0FwNHIrckp5cHEralBYOSsrYXF4WWwK",
      "requireSignedVersion": true,
      "endpoints": []
    }
  }
}
